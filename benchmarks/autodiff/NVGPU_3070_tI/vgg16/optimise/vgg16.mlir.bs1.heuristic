    } -> tensor<1x224x224x64xf32>
    %78 = tosa.equal %global2, %13 : (tensor<1x224x224x64xf32>, tensor<1x224x224x64xf32>) -> tensor<1x224x224x64xi1>
    %79 = tosa.select %78, %77, %9 : (tensor<1x224x224x64xi1>, tensor<1x224x224x64xf32>, tensor<f32>) -> tensor<1x224x224x64xf32>
    %80 = tosa.transpose_conv2d %79, %1, %cst_1 {out_pad = array<i64: -1, -1, -1, -1>, out_shape = array<i64: 1, 224, 224, 64>, stride = array<i64: 1, 1>} : (tensor<1x224x224x64xf32>, tensor<64x3x3x64xf32>, tensor<64xf32>) -> tensor<1x224x224x64xf32>
