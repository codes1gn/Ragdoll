    %82 = tosa.select %81, %80, %9 : (tensor<1x224x224x64xi1>, tensor<1x224x224x64xf32>, tensor<f32>) -> tensor<1x224x224x64xf32>
    %83 = tosa.transpose_conv2d %82, %0, %cst {out_pad = array<i64: -1, -1, -1, -1>, out_shape = array<i64: 1, 224, 224, 3>, stride = array<i64: 1, 1>} : (tensor<1x224x224x64xf32>, tensor<3x3x3x64xf32>, tensor<3xf32>) -> tensor<1x224x224x3xf32>
