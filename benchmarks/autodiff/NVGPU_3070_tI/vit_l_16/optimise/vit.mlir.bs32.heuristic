    %2624 = tosa.transpose_conv2d %2623, %1, %cst {out_pad = array<i64: 0, 0, 0, 0>, out_shape = array<i64: 32, 224, 224, 3>, stride = array<i64: 16, 16>} : (tensor<32x14x14x1024xf32>, tensor<3x16x16x1024xf32>, tensor<3xf32>) -> tensor<32x224x224x3xf32>
    %2625 = tosa.transpose %2624, %0 : (tensor<32x224x224x3xf32>, tensor<4xi64>) -> tensor<32x3x224x224xf32>
    return %2625 : tensor<32x3x224x224xf32>
  }
}

