    %39 = tosa.transpose_conv2d %38, %0, %cst {out_pad = array<i64: -2, -2, -2, -2>, out_shape = array<i64: 1, 224, 224, 3>, stride = array<i64: 4, 4>} : (tensor<1x55x55x64xf32>, tensor<3x11x11x64xf32>, tensor<3xf32>) -> tensor<1x224x224x3xf32>
    return %39 : tensor<1x224x224x3xf32>
  }
}

